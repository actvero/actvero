{
  "realm": "actvero",
  "displayName": "Actvero",
  "enabled": true,
  "loginTheme": "actvero",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "zh-CN",
    "en"
  ],
  "defaultLocale": "zh-CN",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clients": [
    {
      "clientId": "actvero-web",
      "name": "actvero-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${ACTVERO_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${ACTVERO_APP_URL}/api/v1/auth/callback",
        "${ACTVERO_APP_URL}/join",
        "${ACTVERO_APP_URL}/organization-invite",
        "${ACTVERO_APP_URL}/organization-onboarding",
        "${ACTVERO_APP_URL}/api/v1/organization-onboarding/verified/*"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${ACTVERO_APP_URL}/"
      },
      "protocolMappers": [
        {
          "name": "actvero-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "actvero-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "actvero-web-session-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "actvero-web",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "actvero-provisioner",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${ACTVERO_PROVISIONER_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true
    },
    {
      "clientId": "actvero-desktop",
      "name": "Actvero Desktop",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1/actvero/callback"
      ],
      "webOrigins": [],
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": ""
      }
    },
    {
      "clientId": "actvero-cli",
      "name": "Actvero 管理 CLI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1/actvero/cli/callback"
      ],
      "webOrigins": [],
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": ""
      }
    }
  ],
  "passwordPolicy": "length(12)",
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "editUsernameAllowed": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@actvero.test",
    "fromDisplayName": "Actvero",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "users": [
    {
      "username": "service-account-actvero-provisioner",
      "enabled": true,
      "serviceAccountClientId": "actvero-provisioner",
      "clientRoles": {
        "realm-management": [
          "query-users",
          "view-users",
          "manage-users",
          "manage-realm"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"\\u7528\\u6237\\u540d\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"email\", \"displayName\": \"\\u90ae\\u7bb1\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"firstName\", \"displayName\": \"\\u59d3\\u540d\", \"validations\": {\"length\": {\"max\": 100}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"actvero_setup\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}}, {\"name\": \"actvero_member\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}}]}"
          ]
        }
      }
    ]
  }
}
