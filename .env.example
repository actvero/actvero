# Deployment edition: community (one organization) or saas (platform operations).
ACTVERO_PLATFORM_EDITION=community
# Local development only. Independent secrets are generated without overwriting.
ACTVERO_APP_URL=http://127.0.0.1:5194
ACTVERO_OIDC_ISSUER=http://127.0.0.1:5196/realms/actvero
ACTVERO_DATABASE_URL=postgresql+asyncpg://actvero:__APP_DB_PASSWORD__@127.0.0.1:5494/actvero
ACTVERO_DB_PASSWORD=__APP_DB_PASSWORD__
KEYCLOAK_DB_PASSWORD=__KEYCLOAK_DB_PASSWORD__
POSTGRES_ADMIN_PASSWORD=__POSTGRES_ADMIN_PASSWORD__
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=__KEYCLOAK_ADMIN_PASSWORD__
ACTVERO_WEB_CLIENT_SECRET=__WEB_CLIENT_SECRET__
ACTVERO_PROVISIONER_CLIENT_SECRET=__PROVISIONER_CLIENT_SECRET__
ACTVERO_SESSION_ENCRYPTION_KEY=__SESSION_ENCRYPTION_KEY__
# Optional: use a distinct cookie name for deployments sharing one hostname.
# ACTVERO_SESSION_COOKIE_NAME=actvero_community_session
# Local capture mailbox only. Configure real SMTP explicitly for deployment.
ACTVERO_SMTP_HOST=127.0.0.1
ACTVERO_SMTP_PORT=5197
ACTVERO_SMTP_FROM=noreply@actvero.test
ACTVERO_SMTP_STARTTLS=false
# Optional: Keycloak container uses its own address for the same local SMTP service.
# ACTVERO_IDENTITY_SMTP_LOOPBACK_HOST=mailpit
# ACTVERO_IDENTITY_SMTP_LOOPBACK_PORT=1025
# Invitation expiry for this example configuration.
ACTVERO_INVITATION_HOURS=24

# MCP 默认只访问公网 HTTPS。内网需逐个放行来源（协议、主机、端口），例如 ["http://127.0.0.1:5300"]。
ACTVERO_MCP_ALLOWED_PRIVATE_ORIGINS=[]

# 公网 MCP DNS：默认 system；代理 Fake-IP 环境可选 cloudflare（固定 1.1.1.1 DoH）。
# 仅发送域名，不发送路径或凭据；显式放行的内网来源仍使用系统 DNS。
ACTVERO_MCP_PUBLIC_DNS=system

# LLM 渠道拥有独立的内网白名单，不继承 MCP 的放行范围。
ACTVERO_LLM_ALLOWED_PRIVATE_ORIGINS=[]
ACTVERO_LLM_PUBLIC_DNS=system

# Web: opt in to rolling login; align Keycloak SSO/client idle/max separately.
ACTVERO_WEB_SESSION_POLICY=strict
ACTVERO_WEB_RECOVERY_DAYS=30
ACTVERO_WEB_REAUTHENTICATION_DAYS=90
# strict uses ACTVERO_SESSION_HOURS (default 8); old sessions keep their original deadline.

# Desktop policy is independent; refresh recovery v2 requires durable state + acknowledgement.
ACTVERO_DESKTOP_SESSION_POLICY=strict
ACTVERO_DESKTOP_RECOVERY_DAYS=30
ACTVERO_DESKTOP_UNCONFIRMED_DAYS=7
# Optional ACTVERO_DESKTOP_REAUTHENTICATION_DAYS=90

# CLI management is an independent login/scope, enabled explicitly after migration/client import.
ACTVERO_MANAGEMENT_ENABLED=false
ACTVERO_MANAGEMENT_CLIENT_ID=actvero-cli
ACTVERO_MANAGEMENT_ACCESS_SECONDS=300
ACTVERO_MANAGEMENT_RECOVERY_DAYS=30
ACTVERO_MANAGEMENT_REAUTHENTICATION_DAYS=90
